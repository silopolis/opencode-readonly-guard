{
  "$schema": "./schema/patterns.schema.json",
  "version": 1,
  "rules": [
    { "pattern": "*-delete*", "reason": "find -delete removes files" },
    { "pattern": "*-exec*", "reason": "find -exec/-execdir run other programs" },
    { "pattern": "* -ok*", "reason": "find -ok/-okdir run other programs" },
    { "pattern": "*-fprint*", "reason": "find -fprint/-fprintf/-fprint0 write files" },
    { "pattern": "*-fls*", "reason": "find -fls writes a file" },
    { "pattern": "* --output*", "reason": "git diff/log/show --output=FILE writes a file" },
    { "pattern": "* --pre *", "reason": "rg --pre COMMAND runs a program on every file" },
    { "pattern": "*--pre=*", "reason": "rg --pre=COMMAND runs a program on every file" },
    { "pattern": "tree *-o*", "reason": "tree -o FILE writes a file" },
    { "pattern": "rtk tree *-o*", "reason": "tree -o FILE writes a file" },
    { "pattern": "fd *-x*", "reason": "fd -x/--exec run a program per result" },
    { "pattern": "fd *-X*", "reason": "fd -X/--exec-batch run a program on all results" },
    { "pattern": "file *-C*", "reason": "file -C compiles a magic file" },
    { "pattern": "sort *-o*", "reason": "sort -o FILE writes a file" }
  ]
}
