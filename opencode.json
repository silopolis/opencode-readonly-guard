{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["."],
  "permission": {
    "bash": {
      "*": "ask",
      "mise run check *": "allow",
      "mise run lint *": "allow",
      "mise run fmt *": "allow",
      "mise run fmt:check *": "allow",
      "mise run typecheck *": "allow",
      "mise run test *": "allow",
      "mise tasks": "allow",
      "bun test *": "allow",
      "bun src/cli.ts check *": "allow",
      "bun src/cli.ts vet *": "allow",
      "bun src/cli.ts rules *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "gh pr view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "rtk mise run check *": "allow",
      "rtk mise run lint *": "allow",
      "rtk mise run fmt *": "allow",
      "rtk mise run fmt:check *": "allow",
      "rtk mise run typecheck *": "allow",
      "rtk mise run test *": "allow",
      "rtk bun test *": "allow",
      "rtk git status *": "allow",
      "rtk git diff *": "allow",
      "rtk git log *": "allow",
      "rtk git show *": "allow",
      "rtk gh pr view *": "allow",
      "rtk gh pr checks *": "allow",
      "rtk gh pr diff *": "allow",
      "rtk gh run list *": "allow",
      "rtk gh run view *": "allow",
      "* --output*": "ask",
      "mise run *:::*": "ask",
      "rtk mise run *:::*": "ask"
    }
  }
}
